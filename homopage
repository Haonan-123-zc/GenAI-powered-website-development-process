<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hainan Auto Hub | 海南汽车交易中心</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        .hero-bg {
            background: linear-gradient(rgba(0,0,0,0.65), rgba(0,0,0,0.65)), url('https://picsum.photos/id/1015/2000/1200') center/cover no-repeat;
        }
    </style>
</head>
<body class="bg-gray-50 font-sans">

    <!-- Navbar -->
    <nav class="bg-white shadow-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <i class="fa-solid fa-car text-3xl text-blue-600"></i>
                <h1 class="text-2xl font-bold text-gray-900">海南汽车交易中心</h1>
            </div>
            
            <div class="hidden md:flex items-center gap-8 text-lg">
                <a href="index.html" class="text-blue-600 font-medium hover:text-blue-700">首页</a>
                <a href="search.html" class="hover:text-blue-600">搜索车辆</a>
                <a href="seller.html" class="hover:text-blue-600">卖家中心</a>
                <a href="register.html" class="hover:text-blue-600">注册</a>
                <a href="login.html" class="hover:text-blue-600">登录</a>
            </div>

            <button onclick="window.location.href='search.html'" 
                    class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-2xl font-medium flex items-center gap-2 transition">
                <i class="fa-solid fa-magnifying-glass"></i>
                搜索车辆
            </button>
        </div>
    </nav>

    <!-- Hero -->
    <section class="hero-bg text-white py-28">
        <div class="max-w-7xl mx-auto px-6 text-center">
            <h2 class="text-5xl md:text-6xl font-bold mb-6">买车卖车，就在海南汽车交易中心</h2>
            <p class="text-2xl mb-12 max-w-2xl mx-auto">GenAI 驱动的现代汽车交易平台</p>
            <div class="flex justify-center gap-6 flex-wrap">
                <a href="search.html" class="bg-white text-blue-600 px-10 py-4 rounded-3xl font-semibold text-xl hover:bg-gray-100 transition">立即搜索车辆 →</a>
                <a href="seller.html" class="border-2 border-white px-10 py-4 rounded-3xl font-semibold text-xl hover:bg-white hover:text-blue-600 transition">我是卖家</a>
            </div>
        </div>
    </section>

    <!-- Intro + Stats -->
    <section class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid md:grid-cols-2 gap-12 items-center">
                <div>
                    <h3 class="text-4xl font-bold mb-6">关于我们</h3>
                    <p class="text-lg text-gray-600">这是一个使用 GenAI 辅助开发的在线汽车交易平台，支持卖家发布车辆、买家搜索车辆，全部页面均为响应式设计。</p>
                </div>
                <div class="grid grid-cols-2 gap-8 text-center">
                    <div class="bg-gray-50 rounded-3xl p-8">
                        <div class="text-5xl font-bold text-blue-600">500+</div>
                        <div class="text-gray-500">已售车辆</div>
                    </div>
                    <div class="bg-gray-50 rounded-3xl p-8">
                        <div class="text-5xl font-bold text-blue-600">1200+</div>
                        <div class="text-gray-500">注册用户</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Featured Cars -->
    <section class="py-20 bg-gray-50">
        <div class="max-w-7xl mx-auto px-6">
            <h3 class="text-3xl font-bold text-center mb-12">精选车辆</h3>
            <div class="grid md:grid-cols-3 gap-8">
                <div class="bg-white rounded-3xl overflow-hidden shadow hover:shadow-2xl transition">
                    <img src="https://picsum.photos/id/1015/600/400" class="w-full h-56 object-cover" alt="">
                    <div class="p-6">
                        <div class="flex justify-between items-baseline"><h4 class="font-semibold text-lg">Toyota Camry 2023</h4><span class="text-emerald-600 font-bold">¥168,000</span></div>
                        <p class="text-gray-500">海口 · 白色 · 2.0L</p>
                    </div>
                </div>
                <!-- 另外两辆车类似，可自行补充 -->
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-gray-900 text-gray-400 py-12 text-center">
        <p>© 2026 海南汽车交易中心 | Delivery 2 - GenAI Powered</p>
        <p class="text-xs mt-2">Created with Grok AI • Homepage by F1ash</p>
    </footer>

</body>
</html>
